<UserControl x:Class="AVACC.App.Views.CommandEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:AVACC.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:CommandEditorViewModel}"
             d:DesignHeight="750" d:DesignWidth="1100">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <!-- Top Controls: Search, Category Filter, Actions -->
            <RowDefinition Height="Auto" />
            <!-- Main Area: Left (Registry Table), Right (Command Editor & Manual Testing) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP TOOLBAR -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,10,0" VerticalAlignment="Center" />

                <!-- Category Filter -->
                <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" 
                          VerticalAlignment="Center" Margin="0,0,10,0" Height="28" />

                <TextBlock Grid.Column="2" Text="Configure verified Crew Chief identifiers. The AI will strictly choose from enabled commands." 
                           VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />

                <!-- Toolbar Actions -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="Import CSV" Command="{Binding ImportCsvCommand}" Style="{StaticResource ModernButtonStyle}" Margin="0,0,6,0" />
                    <Button Content="CSV Template" Command="{Binding ExportCsvTemplateCommand}" Style="{StaticResource ModernButtonStyle}" Margin="0,0,6,0" />
                    <Button Content="+ New Command" Command="{Binding AddNewCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,6,0" />
                    <Button Content="Reset Defaults" Command="{Binding ResetToDefaults}" Style="{StaticResource ModernButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN SPLIT CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: COMMAND REGISTRY TABLE -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="COMMAND REGISTRY" Style="{StaticResource CardHeaderStyle}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ActiveCommandsCountText}" 
                                   FontSize="11" Foreground="#4ADE80" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Enable All" Command="{Binding EnableAllCommand}" Style="{StaticResource ModernButtonStyle}" Padding="6,2" Margin="0,0,4,0" FontSize="10" ToolTip="Enable all commands for AI selection" />
                            <Button Content="Disable All" Command="{Binding DisableAllCommand}" Style="{StaticResource ModernButtonStyle}" Padding="6,2" Margin="0,0,4,0" FontSize="10" ToolTip="Disable all commands to send minimum tokens" />
                            <Button Content="Disable Rally" Command="{Binding DisableRallyCommand}" Style="{StaticResource ModernButtonStyle}" Padding="6,2" FontSize="10" ToolTip="Disable all Rally pace notes to save tokens for circuit racing" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="#0C0D10" CornerRadius="4" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                        <DataGrid ItemsSource="{Binding CommandsView}" SelectedItem="{Binding SelectedCommand, Mode=TwoWay}"
                                  IsSynchronizedWithCurrentItem="True" AutoGenerateColumns="False"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#0AFFFFFF"
                                  Foreground="{StaticResource TextPrimaryBrush}" HorizontalGridLinesBrush="#1F232B"
                                  BorderThickness="0" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                                <DataGridTextColumn Header="Friendly Name" Binding="{Binding Name}" Width="140" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Crew Chief Command ID" Binding="{Binding CrewChiefCommandId}" Width="190" FontFamily="Cascadia Code, Consolas" />
                                <DataGridTextColumn Header="Voice Line (TTS)" Binding="{Binding VoiceLine}" Width="150" FontStyle="Italic" />
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="80" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: COMMAND EDIT & MANUAL TESTING -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <!-- EDIT COMMAND PANEL -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="EDIT COMMAND DEFINITION" Style="{StaticResource CardHeaderStyle}" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Display Name:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Content="Enabled" IsChecked="{Binding EditIsEnabled}" 
                                          VerticalAlignment="Bottom" Margin="10,0,0,4" Foreground="{StaticResource TextPrimaryBrush}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Crew Chief Command ID (Exact):" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding EditCommandId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CodeBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Category:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding EditCategory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Description:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                            <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" 
                                     Height="48" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8" />

                            <TextBlock Text="Voice Line (exact verbal phrase spoken to Crew Chief):" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                            <TextBox Text="{Binding EditVoiceLine, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,8" />

                            <TextBlock Text="Natural Language Examples (one per line):" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                            <TextBox Text="{Binding EditExamplesText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" 
                                     Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8" />

                            <TextBlock Text="Aliases (comma-separated):" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                            <TextBox Text="{Binding EditAliasesText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,10" />

                            <!-- Save / Cancel / Delete Actions -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource ModernButtonStyle}" 
                                        Foreground="{StaticResource AccentRedBrush}" Margin="0,0,6,0" />
                                <Button Content="Cancel" Command="{Binding CancelEdit}" Style="{StaticResource ModernButtonStyle}" Margin="0,0,6,0" />
                                <Button Content="Save Command" Command="{Binding SaveCommand}" Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- D. MANUAL COMMAND TESTING AREA -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="MANUAL COMMAND INTENT TESTER" Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,6" />

                        <!-- Manual Test Input -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding TestInputSentence, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Content="Test Mapping" Command="{Binding RunManualTest}" 
                                    Style="{StaticResource AccentButtonStyle}" Padding="10,6" />
                        </Grid>

                        <!-- Test Results Card -->
                        <Border Grid.Row="2" Background="#101216" CornerRadius="4" Padding="10" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Mapped Command:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding TestResultSuggestedCommand, FallbackValue='(Enter sentence and click Test)'}" 
                                               FontSize="12" FontWeight="Bold" FontFamily="Cascadia Code, Consolas" Foreground="{StaticResource AccentCyanBrush}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Confidence:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding TestResultConfidence, FallbackValue='N/A'}" 
                                               FontSize="11" Foreground="{StaticResource AccentGreenBrush}" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Explanation:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding TestResultReason, FallbackValue='N/A'}" 
                                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- CSV IMPORT PREVIEW & EDIT MODAL OVERLAY -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Background="#E008090C"
              Visibility="{Binding IsImportingCsv, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="100">
            <Border Width="960" Height="580" Style="{StaticResource CardStyle}" 
                    Background="#16181D" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1"
                    Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="IMPORT COMMANDS FROM CSV — PREVIEW &amp; EDIT" Style="{StaticResource CardHeaderStyle}" Margin="0" />
                        <TextBlock Grid.Column="1" Text="{Binding StagedImportCommands.Count, StringFormat='{}{0} commands loaded'}" 
                                   FontSize="11" Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold" />
                    </Grid>

                    <TextBlock Grid.Row="1" Text="Review and edit the parsed commands before adding them to your registry. You can edit cells directly or deselect commands you do not want to import."
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap" />

                    <!-- Staging DataGrid -->
                    <Border Grid.Row="2" Background="#0C0D10" CornerRadius="4" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,12">
                        <DataGrid ItemsSource="{Binding StagedImportCommands}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="#0AFFFFFF"
                                  Foreground="{StaticResource TextPrimaryBrush}" HorizontalGridLinesBrush="#1F232B"
                                  BorderThickness="0" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Import" Binding="{Binding IsSelected}" Width="55" />
                                <DataGridTextColumn Header="Friendly Name" Binding="{Binding Name}" Width="140" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Crew Chief Command ID" Binding="{Binding CrewChiefCommandId}" Width="170" FontFamily="Cascadia Code, Consolas" />
                                <DataGridTextColumn Header="Voice Line (TTS)" Binding="{Binding VoiceLine}" Width="140" />
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="85" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="160" />
                                <DataGridTextColumn Header="Examples (semicolon-separated)" Binding="{Binding ExamplesRaw}" Width="160" />
                                <DataGridTextColumn Header="Aliases (comma-separated)" Binding="{Binding AliasesRaw}" Width="110" />
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsEnabled}" Width="50" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Actions -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Tip: Examples should be common natural language phrases driver might say." 
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Cancel" Command="{Binding CancelImportCommand}" Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,0" Padding="14,6" />
                            <Button Content="Confirm &amp; Import All" Command="{Binding ConfirmImportCommand}" Style="{StaticResource AccentButtonStyle}" Padding="16,6" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

