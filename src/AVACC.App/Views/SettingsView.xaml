<UserControl x:Class="AVACC.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:AVACC.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
             d:DesignHeight="750" d:DesignWidth="1100">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="Transparent" Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: AI Providers & Processing Architecture -->
            <StackPanel Grid.Column="0" Margin="0,0,8,0">

                <!-- A. AI PROVIDER & CREDENTIALS (BYOK) -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="AI PROVIDER SETTINGS (BRING YOUR OWN KEY)" Style="{StaticResource CardHeaderStyle}" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Select Provider:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableProviders}" SelectedItem="{Binding SelectedProvider}" Height="28" />
                        </Grid>

                        <TextBlock Text="API Key:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,2" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ApiKeyInput, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource CodeBoxStyle}" Margin="0,0,6,0" />
                            <Button Grid.Column="1" Content="Save Key" Command="{Binding SaveApiKeyCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,6,0" />
                            <Button Grid.Column="2" Content="Remove" Command="{Binding RemoveApiKeyCommand}" Style="{StaticResource ModernButtonStyle}" 
                                    Foreground="{StaticResource AccentRedBrush}" />
                        </Grid>

                        <TextBlock Text="All API keys are encrypted at rest using Windows DPAPI (current user credentials). Never stored in plaintext." 
                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />

                        <!-- Connection Test Button & Output -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Test API Connection" Command="{Binding TestConnectionCommand}" 
                                    Style="{StaticResource ModernButtonStyle}" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="{Binding ConnectionTestStatus}" VerticalAlignment="Center" FontSize="11" 
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- B. PROCESSING ARCHITECTURE -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="PROCESSING ARCHITECTURE" Style="{StaticResource CardHeaderStyle}" />

                        <!-- Mode Selection Radio Buttons -->
                        <RadioButton Content="Simple Mode — Single Multimodal Model (Recommended)" 
                                     IsChecked="{Binding IsSimpleMode}" GroupName="ArchMode" 
                                     FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Direct audio ingestion via audio-capable models (e.g. Gemini 2.5 Flash). Audio goes directly to model; returns structured transcript and command." 
                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="20,0,0,12" TextWrapping="Wrap" />

                        <RadioButton Content="Advanced Mode — Two-Model Architecture" 
                                     IsChecked="{Binding IsAdvancedMode}" GroupName="ArchMode" 
                                     FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="Audio is first transcribed by an STT provider (e.g. Whisper), then interpreted into a command by an independent LLM." 
                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="20,0,0,12" TextWrapping="Wrap" />

                        <Separator Background="{StaticResource CardBorderBrush}" Margin="0,0,0,12" />

                        <!-- Simple Mode Config -->
                        <StackPanel Visibility="{Binding IsSimpleMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Select Multimodal Audio Model:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="↻ Refresh Models" Command="{Binding RefreshModelsCommand}" Style="{StaticResource ModernButtonStyle}" Padding="6,2" FontSize="10" />
                            </Grid>
                            <ComboBox ItemsSource="{Binding AvailableModels}" SelectedValue="{Binding SelectedModel}" SelectedValuePath="Id" DisplayMemberPath="DisplayName" Height="28" Margin="0,0,0,8" />
                            <TextBlock Text="Manual Model ID Override (Optional):" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                            <TextBox Text="{Binding ManualModelOverride, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CodeBoxStyle}" />
                        </StackPanel>

                        <!-- Advanced Mode Config -->
                        <StackPanel Visibility="{Binding IsAdvancedMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="STT Provider:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                                    <ComboBox ItemsSource="{Binding AvailableProviders}" SelectedItem="{Binding SelectedSttProvider}" Height="28" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="STT Model:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                                    <ComboBox ItemsSource="{Binding AvailableSttModels}" SelectedValue="{Binding SelectedSttModel}" SelectedValuePath="Id" DisplayMemberPath="DisplayName" Height="28" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="LLM Provider:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                                    <ComboBox ItemsSource="{Binding AvailableProviders}" SelectedItem="{Binding SelectedLlmProvider}" Height="28" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="LLM Model:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2" />
                                    <ComboBox ItemsSource="{Binding AvailableLlmModels}" SelectedValue="{Binding SelectedLlmModel}" SelectedValuePath="Id" DisplayMemberPath="DisplayName" Height="28" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Separator Background="{StaticResource CardBorderBrush}" Margin="0,12,0,10" />

                        <!-- Prompt Optimization Option -->
                        <CheckBox Content="Optimize prompt payload (Compact lookup table)" 
                                  IsChecked="{Binding OptimizePromptPayload}" 
                                  Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Reduces token payload by ~90% by sending compact command descriptions instead of bulky examples. Prevents token limit errors (TPM / 413) on Groq and free-tier models." 
                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="20,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- C. CREW CHIEF INTEGRATION (OFFLINE AUDIO BRIDGE) -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CREW CHIEF INTEGRATION (OFFLINE AUDIO BRIDGE)" Style="{StaticResource CardHeaderStyle}" Margin="0" />
                            <Button Grid.Column="1" Content="Refresh Devices" Command="{Binding RefreshPlaybackDevicesCommand}" Style="{StaticResource ModernButtonStyle}" Padding="8,3" FontSize="11" />
                        </Grid>

                        <TextBlock Text="Zero-token offline bridge: Synthesizes canonical Crew Chief trigger phrases via local Windows TTS and feeds them into Crew Chief's listening device (e.g. VB-Audio Virtual Cable)." 
                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <CheckBox Content="Enable Crew Chief Audio Bridge (Offline Windows TTS loopback)" 
                                  IsChecked="{Binding EnableCrewChiefBridge}" 
                                  Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,0,0,6" />

                        <CheckBox Content="Automatically push recognized commands to Crew Chief" 
                                  IsChecked="{Binding AutoSendToCrewChief}" 
                                  Foreground="{StaticResource TextPrimaryBrush}" Margin="20,0,0,10" />

                        <TextBlock Text="Target Audio Device (Virtual Cable for Crew Chief Input):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AvailablePlaybackDevices}" SelectedItem="{Binding SelectedPlaybackDevice}" Height="28" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Crew Chief PTT Simulation Key:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableCrewChiefPttKeys}" SelectedItem="{Binding CrewChiefPttKey}" Height="26" Width="140" HorizontalAlignment="Left" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TTS Speech Rate:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Value="{Binding TtsSpeechRate}" Minimum="-5" Maximum="5" SmallChange="1" LargeChange="1" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding TtsSpeechRate, StringFormat='{}{0:+0;-0;0}'}" FontSize="11" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Test Button -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{Binding TestAudioBridgeButtonText, FallbackValue='Test Audio Bridge (Play \'can you hear me\')'}" Command="{Binding TestCrewChiefBridgeCommand}" 
                                    Style="{StaticResource ModernButtonStyle}" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="{Binding CrewChiefTestStatus}" VerticalAlignment="Center" FontSize="10" 
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- RIGHT COLUMN: PTT, Audio Capture & Privacy -->
            <StackPanel Grid.Column="1" Margin="8,0,0,0">

                <!-- D. PUSH-TO-TALK SETTINGS -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="PUSH-TO-TALK CONFIGURATION" Style="{StaticResource CardHeaderStyle}" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PTT Trigger Key:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding PttKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CodeBoxStyle}" Width="160" HorizontalAlignment="Left" />
                        </Grid>

                        <CheckBox Content="Enable Global Keyboard Hook (Works while in Assetto Corsa Competizione)" 
                                  IsChecked="{Binding IsGlobalPtt}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />

                        <CheckBox Content="Disable PTT Hook when AVACC application is inactive" 
                                  IsChecked="{Binding DisablePttWhenInactive}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Max Recording Duration:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Value="{Binding MaxRecordingDuration}" Minimum="3" Maximum="30" SmallChange="1" LargeChange="5" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding MaxRecordingDuration, StringFormat='{}{0}s'}" FontSize="11" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </Grid>

                        <CheckBox Content="Voice Activity Detection (auto-cut prolonged silence)" 
                                  IsChecked="{Binding VoiceActivityDetection}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <CheckBox Content="Noise suppression filter" 
                                  IsChecked="{Binding NoiseSuppression}" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- E. AUDIO CAPTURE SETTINGS -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="WASAPI AUDIO CAPTURE" Style="{StaticResource CardHeaderStyle}" Margin="0" />
                            <Button Grid.Column="1" Content="Refresh Devices" Command="{Binding RefreshAudioDevicesCommand}" Style="{StaticResource ModernButtonStyle}" Padding="8,3" FontSize="11" />
                        </Grid>

                        <TextBlock Text="Microphone Input Device:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AvailableAudioDevices}" SelectedItem="{Binding SelectedAudioDevice}" Height="28" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Audio Sample Rate:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableSampleRates}" SelectedItem="{Binding SampleRate}" Height="26" Width="180" HorizontalAlignment="Left" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mic Software Gain:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Value="{Binding InputBoost}" Minimum="0.5" Maximum="3.0" SmallChange="0.1" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding InputBoost, StringFormat='{}{0:F1}x'}" FontSize="11" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- F. PRIVACY, SECURITY & SAVE -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="PRIVACY &amp; LOCAL SECURITY" Style="{StaticResource CardHeaderStyle}" />

                        <TextBlock Text="• Microphone audio is strictly captured while holding your configured PTT button." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="• Captured audio is streamed strictly to your configured AI provider." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="• Raw audio recordings are never retained on disk by default." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="• Version 0.1 does not connect to Crew Chief or inject into game processes." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />

                        <Button Content="Save All Application Settings" Command="{Binding SaveSettingsCommand}" 
                                Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Padding="18,8" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
