<UserControl x:Class="AVACC.App.Views.VisualCMDView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:AVACC.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:VisualCMDViewModel}"
             d:DesignHeight="750" d:DesignWidth="1100">
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN: PTT & Audio Status + Command Interpretation Output -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
            <StackPanel Margin="0,0,6,0">
                
                <!-- A. PTT STATUS PANEL -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="PUSH TO TALK STATUS" Style="{StaticResource CardHeaderStyle}" />
                        
                        <Border Background="#101216" CornerRadius="6" Padding="14" Margin="0,0,0,10" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <!-- State Indicator Circle -->
                                <Ellipse Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,12,0"
                                         Fill="{Binding CurrentState, Converter={StaticResource StateToColorConverter}}" />
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentState}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding StateMessage}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                
                                <TextBlock Grid.Column="2" Text="{Binding RecordingDurationText}" VerticalAlignment="Center"
                                           FontSize="15" FontWeight="SemiBold" FontFamily="Cascadia Code, Consolas" Foreground="{StaticResource AccentAmberBrush}" />
                            </Grid>
                        </Border>

                        <!-- Interactive Hold-to-Speak button for testing -->
                        <Button Content="🎙 Hold to Speak (PTT Test Button)" 
                                PreviewMouseDown="OnHoldToSpeakMouseDown"
                                PreviewMouseUp="OnHoldToSpeakMouseUp"
                                MouseLeave="OnHoldToSpeakMouseUp"
                                Style="{StaticResource AccentButtonStyle}"
                                Margin="0,0,0,8" Padding="10,8" />

                        <!-- Non-integration disclaimer note -->
                        <Border Background="#1A2B2F3A" CornerRadius="4" Padding="8,6" Margin="0,4,0,0">
                            <TextBlock Text="ℹ Version 0.1 generates and previews suggestions only. Commands are not executed inside Crew Chief." 
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- B. AUDIO MONITORING -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="AUDIO MONITORING (WASAPI)" Style="{StaticResource CardHeaderStyle}" />
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Microphone:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedMicrophoneName}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Format:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="{Binding SampleRateDisplay}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                        </Grid>

                        <!-- Real-time Level Meter Bar -->
                        <TextBlock Text="Microphone Input Level:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,3" />
                        <Border Height="8" Background="#0A0B0E" CornerRadius="3" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <ProgressBar Value="{Binding MicInputLevel, Mode=OneWay}" Minimum="0" Maximum="1" 
                                         Foreground="{StaticResource AccentGreenBrush}" Background="Transparent" BorderThickness="0" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- C. SPEECH-TO-TEXT OUTPUT -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SPEECH-TO-TEXT TRANSCRIPTION" Style="{StaticResource CardHeaderStyle}" Margin="0" />
                            <TextBlock Grid.Column="1" Text="{Binding SttProvider}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" />
                        </Grid>

                        <Border Background="#101216" CornerRadius="4" Padding="10" MinHeight="55" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding TranscribedText, FallbackValue='(Awaiting driver speech input...)'}" 
                                       FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" FontStyle="Italic" />
                        </Border>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding SttConfidenceDisplay}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding SttLatencyMs, StringFormat='Latency: {0} ms'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- D. LLM INTERPRETATION OUTPUT -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SUGGESTED CREW CHIEF COMMAND" Style="{StaticResource CardHeaderStyle}" Margin="0" />
                            <TextBlock Grid.Column="1" Text="{Binding LlmModel}" FontSize="10" Foreground="{StaticResource AccentAmberBrush}" FontWeight="SemiBold" />
                        </Grid>

                        <!-- Suggested Command Badge & Action -->
                        <Border Background="#191012" CornerRadius="3" Padding="12" Margin="0,0,0,10" BorderBrush="{StaticResource AccentRedBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SUGGESTION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentRedBrush}" VerticalAlignment="Center" />
                                    
                                    <!-- Send to Crew Chief Action Button -->
                                    <Button Grid.Column="1" Command="{Binding SendCommandToCrewChiefCommand}" 
                                            IsEnabled="{Binding CanSendToCrewChief}"
                                            ToolTip="Transmit this command directly to Crew Chief via TTS audio bridge"
                                            Style="{StaticResource AccentButtonStyle}" Padding="10,4" FontSize="11">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▶ Send to Crew Chief" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <TextBlock Text="{Binding SuggestedCommandId, FallbackValue='AWAITING_COMMAND'}" 
                                           FontSize="15" FontWeight="Bold" FontFamily="Cascadia Code, Consolas" Foreground="{StaticResource AccentSilverBrightBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SuggestedCommandDescription}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" 
                                           Margin="0,6,0,0" TextWrapping="Wrap" Visibility="{Binding SuggestedCommandDescription, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />

                                <!-- Canonical trigger phrase & Send status -->
                                <Border Margin="0,8,0,0" Padding="8,5" Background="#120B0D" CornerRadius="2" 
                                        Visibility="{Binding CanSendToCrewChief, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding CrewChiefCanonicalPhrase, StringFormat='TTS Phrase: {0}'}" 
                                                   FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding CrewChiefSendStatus}" 
                                                   FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Intent & Reason -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Intent:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding InterpretedIntent, FallbackValue='None'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Confidence:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding LlmConfidence, StringFormat='{}{0:P0} (Self-reported by LLM)', FallbackValue='N/A'}" FontSize="11" Foreground="{StaticResource AccentGreenBrush}" />
                        </Grid>

                        <TextBlock Text="{Binding LlmReason, StringFormat='Reason: {0}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />

                        <!-- Raw Structured JSON Expander -->
                        <Expander Header="View Structured JSON Response" IsExpanded="True" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                            <TextBox Text="{Binding RawJsonResponse, TargetNullValue='(No JSON response received yet. Trigger PTT or manual test to inspect.)', FallbackValue='(No JSON response received yet. Trigger PTT or manual test to inspect.)'}" 
                                     IsReadOnly="True" Style="{StaticResource CodeBoxStyle}"
                                     Height="110" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" />
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT COLUMN: Real-Time Event Log & Processing History -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <!-- E. EVENT LOG -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header & Actions -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="REAL-TIME DIAGNOSTIC EVENT LOG" Style="{StaticResource CardHeaderStyle}" Margin="0" VerticalAlignment="Center" />
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Copy" Command="{Binding CopyLogsCommand}" Style="{StaticResource ModernButtonStyle}" Padding="10,4" Margin="0,0,6,0" />
                            <Button Content="Clear" Command="{Binding ClearLogsCommand}" Style="{StaticResource ModernButtonStyle}" Padding="10,4" Margin="0,0,6,0" />
                            <Button Content="Export" Command="{Binding ExportLogsCommand}" Style="{StaticResource ModernButtonStyle}" Padding="10,4" />
                        </StackPanel>
                    </Grid>

                    <!-- Log List -->
                    <Border Grid.Row="1" Background="#0C0D10" CornerRadius="4" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                        <ListBox x:Name="EventLogListBox" ItemsSource="{Binding EventLogs}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="55" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding FormattedTimestamp}" FontSize="10" FontFamily="Cascadia Code, Consolas" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="10" FontWeight="SemiBold" 
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <!-- F. RECENT PROCESSING HISTORY -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="RECENT VOICE COMMAND HISTORY" Style="{StaticResource CardHeaderStyle}" Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Clear History" Command="{Binding ClearHistoryCommand}" Style="{StaticResource ModernButtonStyle}" Padding="10,4" />
                    </Grid>

                    <Border Grid.Row="1" Background="#0C0D10" CornerRadius="4" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                        <ListView ItemsSource="{Binding HistoryItems}" SelectedItem="{Binding SelectedHistoryItem}"
                                  Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Time" Width="70" DisplayMemberBinding="{Binding FormattedTimestamp}" />
                                    <GridViewColumn Header="Spoken Transcript" Width="260" DisplayMemberBinding="{Binding Transcript}" />
                                    <GridViewColumn Header="Suggested Command" Width="220" DisplayMemberBinding="{Binding SuggestedCommand}" />
                                    <GridViewColumn Header="Provider" Width="100" DisplayMemberBinding="{Binding Provider}" />
                                    <GridViewColumn Header="Latency" Width="80" DisplayMemberBinding="{Binding FormattedDuration}" />
                                    <GridViewColumn Header="Status" Width="80" DisplayMemberBinding="{Binding Status}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
