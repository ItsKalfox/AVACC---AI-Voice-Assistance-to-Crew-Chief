<Window x:Class="AVACC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:AVACC.App.ViewModels"
        xmlns:views="clr-namespace:AVACC.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        Title="AVACC - AI Voice Assistance to Crew Chief" 
        Icon="pack://application:,,,/Assets/AVACC-icon.ico"
        Height="840" Width="1240" MinHeight="700" MinWidth="980"
        Background="{StaticResource BgDarkBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Motorsport Console Navigation Tab RadioButton Style -->
        <Style x:Key="ConsoleNavTabStyle" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent" Cursor="Hand" Margin="14,0" VerticalAlignment="Stretch">
                            <TextBlock x:Name="tabText" Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="SemiBold" 
                                       Foreground="#8A91A0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0,8,2" />
                            
                            <!-- Glowing Neon Red Underline for Active Tab -->
                            <Border x:Name="activeIndicator" Height="2.5" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                    Background="{StaticResource AccentRedBrush}" CornerRadius="1.25" Visibility="Collapsed" Margin="2,0,2,-0.5">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF3333" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabText" Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="tabText" Property="FontWeight" Value="Bold" />
                                <Setter TargetName="activeIndicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabText" Property="Foreground" Value="#E0E4EC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Header / Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Three-Tab Navigation -->
            <RowDefinition Height="Auto" />
            <!-- Active Tab Content Area -->
            <RowDefinition Height="*" />
            <!-- Subtle Bottom Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. TOP APP HEADER (Motorsport Carbon Fiber) -->
        <Border Grid.Row="0" BorderThickness="0" 
                Background="{StaticResource CarbonFiberPatternBrush}">
            <Grid>
                <!-- Subtle Gradient Sheen Layer -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#14FFFFFF" Offset="0.0" />
                            <GradientStop Color="#00000000" Offset="0.5" />
                            <GradientStop Color="#30000000" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Header Content -->
                <Grid Margin="18,10">
                    <!-- App Branding: Logo Only (Far Left) -->
                    <Image HorizontalAlignment="Left" VerticalAlignment="Center"
                           Source="pack://application:,,,/Assets/AVACC-logo.png" Height="58" Stretch="Uniform" 
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <!-- Active Model & Mode Indicator (Exact Center of Window) -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#E60A0B0E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="12,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="AI ENGINE: " FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentRedBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding ActiveProviderInfo}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Header Right: Crew Chief Launch / Session Button (Far Right) -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                        <!-- Launch Crew Chief Button (Visible when offline) -->
                        <Button Command="{Binding LaunchCrewChiefCommand}" 
                                Visibility="{Binding CanLaunchCrewChief, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Content="LAUNCH CREW CHIEF" Padding="12,6" FontSize="10" FontWeight="Bold" 
                                Style="{StaticResource ModernButtonStyle}" />

                        <!-- Start / Stop Crew Chief Session Button (Visible when process is running) -->
                        <Button Command="{Binding ToggleCrewChiefSessionCommand}" 
                                Visibility="{Binding CanToggleCrewChiefSession, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Content="{Binding SessionButtonText}" Padding="12,6" FontSize="10" FontWeight="Bold"
                                Background="{Binding SessionButtonBackground}" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="2" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. THREE-TAB NAVIGATION BAR (Centered Motorsport Console Pod) -->
        <Grid Grid.Row="1" Height="42" VerticalAlignment="Top" Background="{StaticResource BgDarkBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Far Left: Application Title & Top Dividing Baseline -->
            <Grid Grid.Column="0" Height="36" VerticalAlignment="Top">
                <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" VerticalAlignment="Top" />
                <TextBlock Text="AI VOICE ASSISTANCE TO CREW CHIEF" 
                           FontSize="11" FontWeight="Bold" 
                           Foreground="{StaticResource TextSecondaryBrush}" 
                           VerticalAlignment="Center" HorizontalAlignment="Left" 
                           Margin="18,0,0,0" />
            </Grid>

            <!-- Centered Console Pod -->
            <Grid Grid.Column="1" Height="36" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>

                <!-- Left Wing: Smooth Curved Transition from Baseline to Pod -->
                <Grid Grid.Column="0" Width="28" Height="36">
                    <Path Data="M 0,0 C 12,0 16,36 28,36 L 28,0 Z" Fill="#14161D" />
                    <Path Data="M 0,0 C 12,0 16,36 28,36" Stroke="{StaticResource CardBorderBrush}" StrokeThickness="1" />
                </Grid>

                <!-- Center Pod Body with Navigation Tabs -->
                <Border Grid.Column="1" Height="36" Background="#14161D" 
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1"
                        Margin="-1,0,-1,0" Padding="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
                        <!-- Tab 1: Visual CMD -->
                        <RadioButton Content="Visual CMD" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=0}"
                                     Command="{Binding SelectTabCommand}" CommandParameter="0"
                                     GroupName="NavTabs" Style="{StaticResource ConsoleNavTabStyle}" />

                        <!-- Tab 2: Command Editor -->
                        <RadioButton Content="Command Editor" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=1}"
                                     Command="{Binding SelectTabCommand}" CommandParameter="1"
                                     GroupName="NavTabs" Style="{StaticResource ConsoleNavTabStyle}" />

                        <!-- Tab 3: Settings -->
                        <RadioButton Content="Settings" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=2}"
                                     Command="{Binding SelectTabCommand}" CommandParameter="2"
                                     GroupName="NavTabs" Style="{StaticResource ConsoleNavTabStyle}" />
                    </StackPanel>
                </Border>

                <!-- Right Wing: Smooth Curved Transition from Pod to Baseline -->
                <Grid Grid.Column="2" Width="28" Height="36">
                    <Path Data="M 0,0 L 0,36 C 12,36 16,0 28,0 Z" Fill="#14161D" />
                    <Path Data="M 0,36 C 12,36 16,0 28,0" Stroke="{StaticResource CardBorderBrush}" StrokeThickness="1" />
                </Grid>
            </Grid>

            <!-- Far Right: Crew Chief Status Text & Top Dividing Baseline -->
            <Grid Grid.Column="2" Height="36" VerticalAlignment="Top">
                <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding CrewChiefStatusDisplay}" 
                           FontSize="10" FontWeight="SemiBold" 
                           Foreground="{StaticResource TextMutedBrush}" 
                           VerticalAlignment="Center" HorizontalAlignment="Right" 
                           Margin="0,0,18,0" />
            </Grid>
        </Grid>

        <!-- 3. ACTIVE TAB CONTENT -->
        <Border Grid.Row="2" Padding="18">
            <Grid>
                <!-- Tab 0: Visual CMD View -->
                <Border Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=0}">
                    <views:VisualCMDView DataContext="{Binding VisualCMD}" />
                </Border>

                <!-- Tab 1: Command Editor View -->
                <Border Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=1}">
                    <views:CommandEditorView DataContext="{Binding CommandEditor}" />
                </Border>

                <!-- Tab 2: Settings View -->
                <Border Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=2}">
                    <views:SettingsView DataContext="{Binding Settings}" />
                </Border>
            </Grid>
        </Border>

        <!-- 4. BOTTOM STATUS BAR -->
        <Border Grid.Row="3" Background="#0A0B0E" BorderBrush="{StaticResource CardBorderBrush}" 
                BorderThickness="0,1,0,0" Padding="14,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding PttTriggerStatusText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,24,0" />
                <TextBlock Text="{Binding CrewChiefBridgeStatusText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
