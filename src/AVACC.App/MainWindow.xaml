<Window x:Class="AVACC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:AVACC.App.ViewModels"
        xmlns:views="clr-namespace:AVACC.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        Title="AVACC — AI Voice Assistance to Crew Chief (v0.1 Preview)" 
        Height="840" Width="1240" MinHeight="700" MinWidth="980"
        Background="{StaticResource BgDarkBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Header / Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Three-Tab Navigation -->
            <RowDefinition Height="Auto" />
            <!-- Active Tab Content Area -->
            <RowDefinition Height="*" />
            <!-- Subtle Bottom Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. TOP APP HEADER -->
        <Border Grid.Row="0" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" 
                BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AVACC" FontSize="18" FontWeight="Black" FontFamily="Segoe UI, Segoe UI Variable" 
                               Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,8,0" />
                    <Border Background="#1C212B" CornerRadius="3" Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="v0.0.1-beta" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}" />
                    </Border>
                    <TextBlock Text="AI Voice Assistance to Crew Chief" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Active Model & Mode Indicator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#121418" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4">
                        <TextBlock Text="{Binding ActiveProviderInfo}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>

                <!-- PTT Live State Pill -->
                <Border Grid.Column="2" Background="#14171E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Fill="{Binding VisualCMD.CurrentState, Converter={StaticResource StateToColorConverter}}" />
                        <TextBlock Text="{Binding OverallStatus}" FontSize="11" FontWeight="Bold" FontFamily="Cascadia Code, Consolas" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. THREE-TAB NAVIGATION BAR -->
        <Border Grid.Row="1" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" 
                BorderThickness="0,0,0,1" Padding="18,0">
            <StackPanel Orientation="Horizontal">
                <!-- Tab 1: Visual CMD -->
                <RadioButton Content="01  VISUAL CMD" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=0}"
                             Command="{Binding SelectTabCommand}" CommandParameter="0"
                             GroupName="NavTabs" Style="{x:Null}">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="tabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="18,12" Cursor="Hand">
                                <TextBlock x:Name="tabText" Text="{TemplateBinding Content}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                    <Setter TargetName="tabText" Property="Foreground" Value="{StaticResource AccentCyanBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="tabText" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>

                <!-- Tab 2: Command Editor -->
                <RadioButton Content="02  COMMAND EDITOR" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=1}"
                             Command="{Binding SelectTabCommand}" CommandParameter="1"
                             GroupName="NavTabs" Style="{x:Null}">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="tabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="18,12" Cursor="Hand">
                                <TextBlock x:Name="tabText" Text="{TemplateBinding Content}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                    <Setter TargetName="tabText" Property="Foreground" Value="{StaticResource AccentCyanBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="tabText" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>

                <!-- Tab 3: Settings -->
                <RadioButton Content="03  SETTINGS" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=2}"
                             Command="{Binding SelectTabCommand}" CommandParameter="2"
                             GroupName="NavTabs" Style="{x:Null}">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="tabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="18,12" Cursor="Hand">
                                <TextBlock x:Name="tabText" Text="{TemplateBinding Content}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                    <Setter TargetName="tabText" Property="Foreground" Value="{StaticResource AccentCyanBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="tabText" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- 3. ACTIVE TAB CONTENT -->
        <Border Grid.Row="2" Padding="18">
            <Grid>
                <!-- Tab 0: Visual CMD View -->
                <Border Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=0}">
                    <views:VisualCMDView DataContext="{Binding VisualCMD}" />
                </Border>

                <!-- Tab 1: Command Editor View -->
                <Border Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=1}">
                    <views:CommandEditorView DataContext="{Binding CommandEditor}" />
                </Border>

                <!-- Tab 2: Settings View -->
                <Border Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=2}">
                    <views:SettingsView DataContext="{Binding Settings}" />
                </Border>
            </Grid>
        </Border>

        <!-- 4. BOTTOM STATUS BAR -->
        <Border Grid.Row="3" Background="#0A0B0E" BorderBrush="{StaticResource CardBorderBrush}" 
                BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="● ACC Sim Racing Profile Active" FontSize="10" Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,16,0" />
                    <TextBlock Text="PTT Trigger: Right Ctrl (Global Win32 Hook)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,16,0" />
                    <TextBlock Text="Crew Chief Integration: Disabled (v0.1 Scope: Suggested Commands Only)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="DPAPI Secure Key Storage: Enabled" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
