<Window x:Class="AVACC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:AVACC.App.ViewModels"
        xmlns:views="clr-namespace:AVACC.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        Title="AVACC — AI Voice Assistance to Crew Chief" 
        Icon="pack://application:,,,/Assets/AVACC-icon.png"
        Height="840" Width="1240" MinHeight="700" MinWidth="980"
        Background="{StaticResource BgDarkBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Header / Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Three-Tab Navigation -->
            <RowDefinition Height="Auto" />
            <!-- Active Tab Content Area -->
            <RowDefinition Height="*" />
            <!-- Subtle Bottom Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. TOP APP HEADER (Motorsport Carbon Fiber) -->
        <Border Grid.Row="0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" 
                Background="{StaticResource CarbonFiberPatternBrush}">
            <Grid>
                <!-- Subtle Gradient Sheen Layer -->
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#14FFFFFF" Offset="0.0" />
                            <GradientStop Color="#00000000" Offset="0.5" />
                            <GradientStop Color="#30000000" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Header Content -->
                <Grid Margin="18,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Branding with Bigger Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/AVACC-logo.png" Height="48" Stretch="Uniform" 
                               RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <Border Height="26" Width="1" Background="#33FFFFFF" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <TextBlock Text="AI VOICE ASSISTANCE TO CREW CHIEF" FontSize="11" FontWeight="Bold" 
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Active Model & Mode Indicator -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="#E60A0B0E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="12,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="AI ENGINE: " FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentRedBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding ActiveProviderInfo}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Header Right Status Elements -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Crew Chief Process Status Gauge -->
                        <Border Background="{Binding CrewChiefStateBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="10,6" VerticalAlignment="Center" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                           Fill="{Binding CrewChiefStateColor}" />
                                <TextBlock Text="{Binding CrewChiefStatusDisplay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding LaunchCrewChiefCommand}" 
                                Visibility="{Binding CanLaunchCrewChief, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Content="LAUNCH" Margin="0,0,10,0" Padding="8,4" FontSize="10" FontWeight="Bold" Style="{StaticResource ModernButtonStyle}" VerticalAlignment="Center" />

                        <!-- PTT Live State Gauge -->
                        <Border Background="#E60A0B0E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="12,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                           Fill="{Binding VisualCMD.CurrentState, Converter={StaticResource StateToColorConverter}}" />
                                <TextBlock Text="{Binding OverallStatus}" FontSize="11" FontWeight="Bold" FontFamily="Cascadia Code, Consolas" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. THREE-TAB NAVIGATION BAR -->
        <Border Grid.Row="1" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" 
                BorderThickness="0,0,0,1" Padding="18,0">
            <StackPanel Orientation="Horizontal">
                <!-- Tab 1: Visual CMD -->
                <RadioButton Content="VISUAL CMD" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=0}"
                             Command="{Binding SelectTabCommand}" CommandParameter="0"
                             GroupName="NavTabs" Style="{x:Null}">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="tabBorder" Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent" Padding="20,12" Cursor="Hand">
                                <TextBlock x:Name="tabText" Text="{TemplateBinding Content}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource AccentRedBrush}" />
                                    <Setter TargetName="tabText" Property="Foreground" Value="{StaticResource AccentSilverBrightBrush}" />
                                    <Setter TargetName="tabText" Property="FontWeight" Value="Bold" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="tabText" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>

                <!-- Tab 2: Command Editor -->
                <RadioButton Content="COMMAND EDITOR" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=1}"
                             Command="{Binding SelectTabCommand}" CommandParameter="1"
                             GroupName="NavTabs" Style="{x:Null}">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="tabBorder" Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent" Padding="20,12" Cursor="Hand">
                                <TextBlock x:Name="tabText" Text="{TemplateBinding Content}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource AccentRedBrush}" />
                                    <Setter TargetName="tabText" Property="Foreground" Value="{StaticResource AccentSilverBrightBrush}" />
                                    <Setter TargetName="tabText" Property="FontWeight" Value="Bold" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="tabText" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>

                <!-- Tab 3: Settings -->
                <RadioButton Content="SETTINGS" IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=2}"
                             Command="{Binding SelectTabCommand}" CommandParameter="2"
                             GroupName="NavTabs" Style="{x:Null}">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="tabBorder" Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent" Padding="20,12" Cursor="Hand">
                                <TextBlock x:Name="tabText" Text="{TemplateBinding Content}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource AccentRedBrush}" />
                                    <Setter TargetName="tabText" Property="Foreground" Value="{StaticResource AccentSilverBrightBrush}" />
                                    <Setter TargetName="tabText" Property="FontWeight" Value="Bold" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="tabText" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- 3. ACTIVE TAB CONTENT -->
        <Border Grid.Row="2" Padding="18">
            <Grid>
                <!-- Tab 0: Visual CMD View -->
                <Border Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=0}">
                    <views:VisualCMDView DataContext="{Binding VisualCMD}" />
                </Border>

                <!-- Tab 1: Command Editor View -->
                <Border Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=1}">
                    <views:CommandEditorView DataContext="{Binding CommandEditor}" />
                </Border>

                <!-- Tab 2: Settings View -->
                <Border Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=2}">
                    <views:SettingsView DataContext="{Binding Settings}" />
                </Border>
            </Grid>
        </Border>

        <!-- 4. BOTTOM STATUS BAR -->
        <Border Grid.Row="3" Background="#0A0B0E" BorderBrush="{StaticResource CardBorderBrush}" 
                BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="● ACC Sim Racing Profile Active" FontSize="10" Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,16,0" />
                    <TextBlock Text="PTT Trigger: Right Ctrl (Global Win32 Hook)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding CrewChiefBridgeStatusText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="DPAPI Secure Key Storage: Enabled" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
